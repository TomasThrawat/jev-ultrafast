TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Optional free/local Ollama path (set LLM_PROVIDER=ollama to use it).
# The endpoint must expose an OpenAI-compatible /chat/completions route.
LLM_PROVIDER=typesafe
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gpt-oss:20b

# Optional: expose the development server to a trusted LAN for the Android chat client.
JEV_BIND_HOST=127.0.0.1
JEV_ALLOW_NETWORK=0
